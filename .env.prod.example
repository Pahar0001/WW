# Vela на выделенном сервере. Скопируйте в `.env` рядом с
# docker-compose.prod.yml и заполните. Заполненный .env не коммитить.
#
#   cp .env.prod.example .env && nano .env
#
# Порядок развёртывания целиком — в docs/DEPLOY_DEDICATED.md

# ─── Домен ────────────────────────────────────────────────────────────────
# Без https:// и без косой черты. A-записи домена и www уже должны вести
# на IP этого сервера — иначе Caddy не выпустит сертификат.
DOMAIN=velatrips.ru

# Почта для Let's Encrypt: туда придёт письмо, если сертификат перестанет
# продлеваться. Можно оставить пустой, но лучше указать.
ACME_EMAIL=

# ─── База данных ──────────────────────────────────────────────────────────
# PostgreSQL поднимается на этом же сервере (служба db в compose) и хранит
# данные в томе vela_pgdata. Наружу порт не открыт.
# DATABASE_URL собирается автоматически из этих трёх значений — вписывать
# её отдельно не нужно.
POSTGRES_DB=vela
POSTGRES_USER=vela
# Придумайте длинный пароль: openssl rand -base64 24
POSTGRES_PASSWORD=

# ─── Приложение ───────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=4000
# Адрес в ссылках из писем. Должен совпадать с DOMAIN.
APP_URL=https://velatrips.ru
# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES=7d

# Первый администратор — создаётся при старте, повторный запуск ничего не ломает
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Межсайтовые запросы к API. Обычно не нужны: страница обращается к своему же
# адресу, а Next форвардит запрос на backend внутри сети. Оставьте пустым,
# если у вас нет отдельного клиента на другом домене.
CORS_ORIGIN=

# ─── Почта (необязательно) ────────────────────────────────────────────────
# Если не заполнить, ссылки для входа и подтверждения просто пишутся в лог
# контейнера backend — сервис от этого не падает.
RESEND_API_KEY=
EMAIL_FROM=Vela <no-reply@velatrips.ru>

# ─── ИИ-консультант (необязательно) ───────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Партнёрские программы: ЭТО ДЕНЬГИ ────────────────────────────────────
# Не забыть перенести с Render — без них блок «Перелёт и даты» показывает
# не реальные цены, а предложение поискать самому, а комиссия с бронирований
# перестаёт начисляться. Пропажу заметно не сразу: сайт работает как ни в чём
# не бывало, просто перестаёт зарабатывать.
#
# Travelpayouts (Aviasales Data API) — реальные цены авиабилетов
TRAVELPAYOUTS_TOKEN=
# Партнёрский marker: кабинет → Программы → Aviasales. Тот же marker уходит
# в ссылки на трансферы (Kiwitaxi, GetTransfer)
TRAVELPAYOUTS_MARKER=
# Виджет Kiwitaxi White Label: кабинет → Программы → Kiwitaxi → Виджеты.
# Задан — трансфер оформляется на странице логистики; не задан — только ссылки
KIWITAXI_WL_URL=

# ─── Лента новостей (необязательно) ───────────────────────────────────────
# Формат: "Название|https://url, Название2|https://url2".
# Пусто — берётся список источников по умолчанию из кода
NEWS_FEEDS=

# ─── Видео на первом экране (необязательно) ───────────────────────────────
# Пусто — берётся public/hero/thailand.mp4 из репозитория.
# «none» — видео выключается, остаётся 3D-глобус.
# Внимание: это переменные СБОРКИ. Меняются только пересборкой образа web,
# перезапуска контейнера мало.
NEXT_PUBLIC_HERO_MEDIA_URL=
NEXT_PUBLIC_HERO_MEDIA_POSTER=

# ─── Файлы пользователей ──────────────────────────────────────────────────
# ОСТАВЬТЕ ПУСТЫМИ. Тогда загруженные файлы хранятся в базе на этом же
# сервере и попадают в ночные копии вместе с ней.
#
# Со старой площадки эти переменные переносить не нужно, даже если они там
# заполнены: тот проект Supabase уже удалён, домена нет в DNS. Сайт этого
# не заметил — код пробует хранилище, получает отказ и кладёт файл в базу,
# так что все 17 файлов на месте, просто лежат не там, где задумывалось.
#
# Заполнять имеет смысл, только если файлов станет много и база начнёт
# распухать. Тогда берите российское хранилище — Yandex Object Storage или
# VK Cloud: с зарубежным персональные данные снова уедут за границу.
# S3_REGION должен быть настоящим регионом бакета, «auto» ломает подпись запросов.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
